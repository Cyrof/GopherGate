{{ define "peers_edit.tmpl" }}
<!doctype html>
<html lang="en" data-theme="gophergate">
<head>
  {{ template "partials/head" . }}
</head>
<body class="page-shell">
  <div>
    <input id="app-drawer" type="checkbox" class="drawer-toggle" />

    <div class="drawer-content flex min-h-screen flex-col">
      {{ template "partials/navbar" . }}

      <main class="page-container flex-1">
        <section class="peers-shell">
          <div class="peers-page-header">
            <div>
              <div class="peers-eyebrow">Peer Configuration</div>
              <h1>Edit Peer</h1>
            </div>

            <a href="/peers" class="peers-secondary-action">Back to Peers</a>
          </div>

          {{ if .error }}
          <div class="peers-alert" role="alert">
            {{ .error }}
          </div>
          {{ end }}

          <section class="peers-panel peers-create-panel peers-edit-panel">
            <div class="peers-table-header">
              <div>
                <div class="peers-section-label">Configuration</div>
                <h2>Peer Settings</h2>
              </div>
            </div>

            <div class="peers-note">
              The public key cannot be changed. To use a different key, delete this peer and create a new one.
            </div>

            <form method="post" action="/peers/edit" class="peers-form-grid peers-edit-form-grid">
              <input type="hidden" name="pubkey_original" value="{{ .peer.PublicKey }}" />

              <label class="peers-field peers-field-wide">
                <span>Public Key</span>
                <input id="pubkey" name="pubkey" value="{{ .peer.PublicKey }}" readonly />
              </label>

              <label class="peers-field">
                <span>Allowed IPs</span>
                <input id="ip" name="ip" value="{{ .peer.IP }}" />
                <small>IP addresses this peer can use.</small>
              </label>

              <label class="peers-field">
                <span>Endpoint</span>
                <input id="endpoint" name="endpoint" value="{{ .peer.Endpoint }}" placeholder="192.168.1.100:51820" />
                <small>IP:port where this peer can be reached.</small>
              </label>

              <label class="peers-field">
                <span>Persistent Keepalive</span>
                <input id="keepalive" name="keepalive" value="{{ .peer.Keepalive }}" inputmode="numeric" />
                <small>Interval for keepalive packets. Use 0 to disable.</small>
              </label>

              <div class="peers-current-stats peers-edit-wide">
                <div>
                  <span>Rx</span>
                  <strong>{{ humanBytes .peer.RxBytes }}</strong>
                </div>
                <div>
                  <span>Tx</span>
                  <strong>{{ humanBytes .peer.TxBytes }}</strong>
                </div>
                <div>
                  <span>Last Handshake</span>
                  <strong>{{ handshakeDisplay .peer.Handshake }}</strong>
                </div>
              </div>

              <div class="peers-form-actions peers-field-wide">
                <button type="submit" class="peers-primary-action">Save Changes</button>
              </div>
            </form>
          </section>
        </section>
      </main>

      {{ template "partials/footer" . }}
    </div>

    {{ template "partials/sidebar" . }}
  </div>

  {{ template "partials/scripts" }}
</body>
</html>
{{ end }}
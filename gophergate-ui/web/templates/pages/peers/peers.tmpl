{{ define "peers.tmpl" }}
<!doctype html>
<html lang="en" data-theme="gophergate">
<head>
  {{ template "partials/head" . }}
</head>
<body class="page-shell">
  <div>
    <input id="app-drawer" type="checkbox" class="drawer-toggle" />

    <div class="drawer-content flex min-h-screen flex-col">
      {{ template "partials/navbar" . }}

      <main class="page-container flex-1">
        <section class="peers-shell w-full rounded-[26px] px-4 py-5 lg:px-5 lg:py-6">
          <div class="peers-page-header">
            <div>
              <div class="page-eyebrow">Peer Directory</div>
              <h1 class="page-title">Peers</h1>
            </div>

            <button type="button" class="peers-primary-action" data-create-peer-open>
              Add Peer
            </button>
          </div>

          {{ if .error }}
          <div class="peers-alert" role="alert">
            {{ .error }}
          </div>
          {{ end }}

          <div class="peers-summary-grid">
            <article class="peers-panel peers-enrollment-panel">
              <div class="peers-section-label">Enrollment Queue</div>
              <h2>{{ .pendingApprovals }} Pending Approvals</h2>

              <ul class="peers-enrollment-list">
                {{ range .enrollmentItems }}
                <li>
                  <span>{{ .Name }}</span>
                  <span>{{ .Description }}</span>
                </li>
                {{ else }}
                <li>
                  <span>No enrollment requests</span>
                  <span>queue is clear</span>
                </li>
                {{ end }}
              </ul>
            </article>

            <article class="peers-panel peers-stats-panel">
              <div class="peers-section-label">Quick Stats</div>

              <div class="peers-stat-stack">
                {{ range .stats }}
                <div class="peers-stat-card peers-stat-{{ .State }}">
                  <span>{{ .Label }}</span>
                  <strong>{{ .Value }}</strong>
                </div>
                {{ end }}
              </div>
            </article>
          </div>

          <dialog id="create-peer-dialog" class="peers-create-dialog" data-open-on-load="{{ if .openCreateModal }}true{{ else }}false{{ end }}">
            <form method="post" action="/peers" class="peers-create-modal">
              <div class="peers-create-modal-header">
                <div>
                  <div class="peers-section-label">Create Peer</div>
                  <h2>Add New Peer</h2>
                </div>

                <button
                  type="button"
                  class="peers-create-close"
                  data-create-peer-close
                  aria-label="Close create peer dialog"
                >
                  ×
                </button>
              </div>

              {{ if .createError }}
              <div class="peers-modal-alert" role="alert">
                {{ .createError }}
              </div>
              {{ end }}

              <div class="peers-create-form-grid">
                <label class="peers-field peers-field-wide">
                  <span>Name</span>
                  <input name="name" placeholder="peer-name" value="{{ index .createForm "name" }}" required />
                </label>

                <label class="peers-field peers-field-wide">
                  <span>Public Key</span>
                  <input name="pubkey" placeholder="base64 encoded key" value="{{ index .createForm "pubkey" }}" required />
                </label>

                <label class="peers-field peers-field-wide">
                  <span>Allowed IP</span>
                  <input
                    id="create-peer-allowed-ips"
                    name="ip"
                    placeholder="Leave blank for auto assignment, or enter 10.13.13.25"
                    value="{{ index .createForm "ip" }}"
                  />
                  {{ if .ipPool.Enabled }}
                    {{ if .ipPool.HasAvailable }}
                    <small>
                      Leave blank and the WireGuard agent will assign the next free IP.
                      Current preview: <strong>{{ .ipPool.NextAvailableIP }}</strong>
                      ({{ .ipPool.Available }} of {{ .ipPool.Capacity }} available).
                    </small>
                    {{ else }}
                    <small>
                      The configured automatic IP pool is full. Enter a manual host IP to continue.
                    </small>
                    {{ end }}
                  {{ else }}
                  <small>
                    Automatic assignment is unavailable. Enter a manual host IP, for example 10.13.13.25.
                  </small>
                  {{ end }}
                </label>

                <label class="peers-field peers-field-wide">
                  <span>Endpoint (optional)</span>
                  <input name="endpoint" placeholder="192.168.1.100:51820" value="{{ index .createForm "endpoint" }}" />
                  <small>
                    Leave blank for roaming peers. WireGuard can learn the endpoint from handshakes.
                  </small>
                </label>

                <label class="peers-field peers-field-wide">
                  <span>Persistent Keepalive (seconds)</span>
                  <input name="keepalive" placeholder="25" inputmode="numeric" value="{{ index .createForm "keepalive" }}" />
                </label>
              </div>
              <div class="peers-create-modal-actions">
                <button type="button" class="peers-secondary-action" data-create-peer-close>
                  Cancel
                </button>

                <button type="submit" class="peers-primary-action">
                  Create Peer
                </button>
              </div>
            </form>
          </dialog>

          <section class="peers-panel peers-table-panel">
            <div class="peers-table-header">
              <h2 class="section-title">All Peers</h2>
              <span class="peers-managed-pill">Managed</span>
            </div>

            <div class="peers-table-wrap">
              <table class="peers-table">
                <thead>
                  <tr>
                    <th>Name</th>
                    <th>Public Key</th>
                    <th>Endpoint</th>
                    <th>Allowed IPs</th>
                    <th>Status</th>
                    <th class="peers-actions-heading">Actions</th>
                  </tr>
                </thead>

                <tbody>
                  {{ if .peers }}
                    {{ range .peers }}
                    <tr>
                      <td class="peers-peer-name">{{ .Name }}</td>

                      <td>
                        <code title="{{ .PublicKey }}">{{ shortKey .PublicKey }}</code>
                      </td>

                      <td>{{ .Endpoint }}</td>
                      <td>{{ .IP }}</td>

                      <td>
                        <span class="{{ statePillClass .State }} peers-status-pill">
                          {{ stateDisplay .State }}
                        </span>
                      </td>

                      <td>
                        <div class="peers-row-actions">
                          <a href="/peers/edit?pubkey={{ .PublicKey }}" class="peers-row-action">
                            Edit
                          </a>

                          <button
                            type="button"
                            class="peers-row-action peers-row-danger"
                            data-delete-peer
                            data-peer-name="{{ .Name }}"
                            data-public-key="{{ .PublicKey }}"
                            data-public-key-short="{{ shortKey .PublicKey }}"
                          >
                            Delete
                          </button>
                        </div>
                      </td>
                    </tr>
                    {{ end }}
                  {{ else }}
                    <tr>
                      <td colspan="6" class="peers-empty-state">
                        No peers configured yet. Use Add Peer to enroll the first device.
                      </td>
                    </tr>
                  {{ end }}
                </tbody>
              </table>
            </div>
          </section>

          <dialog id="delete-peer-dialog" class="peers-delete-dialog">
            <form method="post" action="/peers/delete" class="peers-delete-modal">
              <input id="delete-peer-public-key" type="hidden" name="pubkey" value="" />

              <div class="peers-delete-modal-header">
                <div>
                  <div class="peers-section-label">Danger Zone</div>
                  <h2>Delete Peer</h2>
                </div>

                <button
                  type="button"
                  class="peers-delete-close"
                  data-delete-cancel
                  aria-label="Close delete peer dialog"
                >
                  ×
                </button>
              </div>

              <div class="peers-delete-warning">
                <strong>This action cannot be undone.</strong>
                <span>
                  The selected peer will be removed from GopherGate and may lose access to the mesh network.
                </span>
              </div>

              <div class="peers-delete-target">
                <div>
                  <span>Peer</span>
                  <strong id="delete-peer-name">this peer</strong>
                </div>

                <div>
                  <span>Public Key</span>
                  <code id="delete-peer-key">—</code>
                </div>
              </div>

              <div class="peers-delete-actions">
                <button type="button" class="peers-secondary-action" data-delete-cancel>
                  Cancel
                </button>

                <button type="submit" class="peers-row-action peers-row-danger peers-delete-confirm">
                  Delete Peer
                </button>
              </div>
            </form>
          </dialog>
        </section>
      </main>

      {{ template "partials/footer" . }}
    </div>

    {{ template "partials/sidebar" . }}
  </div>

  {{ template "partials/scripts" }}
  <script src="/static/js/peers.js?v=peer-dialogs-1" defer></script>
</body>
</html>
{{ end }}